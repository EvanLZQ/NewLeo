# Example backend .env — copy the lines you need into the server's .env.
# NEVER commit real keys. Only the Stripe section is documented here; the
# rest of the existing .env (DB_*, SECRET_KEY, PAYPAL_*, MAILGUN_*, ...) is unchanged.

# ── Stripe (card payment next to PayPal) — see docs/STRIPE_SETUP.md ──────────
# Master switch. Unset / false = Stripe endpoints answer 404, nothing changes.
STRIPE_ENABLED=false
# Test mode keys start with sk_test_ / pk_test_; live keys with sk_live_ / pk_live_.
STRIPE_SECRET_KEY=
# Not used by the hosted Checkout redirect; kept with the secret key for completeness.
STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint https://admin.eyelovewear.com/api/order/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Optional. Where Stripe sends shoppers back to (defaults to FRONTEND_BASE_URL).
STRIPE_RETURN_BASE_URL=https://eyelovewear.com
# Optional. Card statement suffix (letters/digits, prefix + suffix <= 22 chars).
STRIPE_STATEMENT_DESCRIPTOR_SUFFIX=
